# Copy this file to .env and fill in your real values.
# .env is gitignored - never commit real credentials.

# --- Shared app credentials (from the app's page in the Dev Dashboard) ---
# Shopify retired the old "Custom App -> static token" flow for new apps.
# Since both stores below are your own (same Shopify organization), this
# app uses the client credentials grant instead: one Client ID + Client
# Secret, shared across both stores, exchanged for a short-lived (24h)
# access token per store automatically by shopify_api.py. You never touch
# a per-store token yourself.
SHOPIFY_CLIENT_ID=your_client_id
SHOPIFY_CLIENT_SECRET=shpss_your_client_secret

# --- All Star Elite store ---
# IMPORTANT: this is the real *.myshopify.com domain (Settings > Domains,
# the one tagged "Shopify managed domain") - it will NOT necessarily match
# your store's name or the slug in admin.shopify.com URLs.
ASE_STORE_DOMAIN=your-real-domain.myshopify.com
# Optional: only needed if there's more than one location with "warehouse"
# in its name, or if you'd rather not rely on name-matching at all.
# Find the numeric ID in Settings > Locations > (your warehouse) > URL bar,
# then use it as: gid://shopify/Location/1234567
ASE_WAREHOUSE_LOCATION_ID=

# --- Watson Luxe store ---
WL_STORE_DOMAIN=your-other-real-domain.myshopify.com
WL_WAREHOUSE_LOCATION_ID=

# --- This tool's own login (separate from the TikTok tool's) ---
ONLINE_LOGIN_USERNAME=online
ONLINE_LOGIN_PASSWORD=choose_a_password
FLASK_SECRET_KEY=choose_a_long_random_string

# --- Optional - defaults shown ---
POLL_INTERVAL_SECONDS=180
PORT=5001
NOTIFY_CUSTOMER_ON_LABEL=false

# --- Wave-picking batching (see batching.py) - optional, defaults shown ---
# How many orders/bins are active at once.
ACTIVE_BATCH_SIZE=30
# Bonus (in "hours of priority") for another open order sharing the exact same SKU.
SKU_MATCH_BONUS_HOURS=3
# Bonus for another open order sharing just the category (not exact SKU).
CATEGORY_MATCH_BONUS_HOURS=1
# Max total bonus one order can get from matching others - keeps a product
# cluster from ever beating something that's been waiting far longer.
MATCH_BONUS_CAP_HOURS=20
# If Shopify gives an order a real ship-by deadline, how many hours before/
# after that deadline count as "urgent" and get added to its priority.
DEADLINE_URGENCY_WINDOW_HOURS=48
